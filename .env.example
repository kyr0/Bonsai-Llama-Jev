# Copy to .env and adjust. .env is gitignored and loaded by setup.sh,
# scripts/*.sh (via scripts/common.sh) and the Makefile.
# Already-exported shell env vars win over values in .env.

# Server bind address / port (start_llama_server.sh, make start/status/stop)
# SAI => 541
PORT=54100
BONSAI_HOST=0.0.0.0

# Require this API key on the OpenAI-compatible endpoints (llama-server --api-key).
# Empty = no auth.
#BONSAI_API_KEY=

# Model name reported by /v1/models (llama-server --alias). Default: bonsai-2-27b.
#BONSAI_ALIAS=bonsai-2-27b

# Server-wide generation cap (llama-server --n-predict). Unset or -1 = unlimited;
# per-request max_tokens can only lower it, never exceed it.
#BONSAI_MAX_TOKENS=4096

# Parallel slots (llama-server --parallel): concurrent requests in flight before
# they queue. Unset or 0 = llama.cpp default (4). Raise for concurrent /v1/systemone
# eval/load (8 or 16); with unified KV extra slots cost no extra VRAM, only KV
# space shared between slots. Speculative decoding overrides to 1.
#BONSAI_NP=8

# Typed-decision calibration for /v1/systemone (llama-server
# --systemone-calibration): a deployable calibration.json from the
# typed-decision-bench harness (temperature scaling). Relative paths resolve
# against the repo root. Set to "off" for uncalibrated probabilities.
#BONSAI_CALIBRATION=calibration.json

# Model selection (see scripts/common.sh)
#BONSAI_FAMILY=bonsai2
#BONSAI_MODEL=27B

# Vision projector (multimodal image input) paired with the 27B model.
BONSAI_MMPROJ=/path/to/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-mmproj-Q8_0.gguf

# Full GPU offload = 99 (fastest), partial GPU offload = 50 (slower), no GPU offload = 0 (slowest).
BONSAI_NGL=99

# Model GGUF file path (llama-server --model). Absolute path or relative to the Makefile.
BONSAI_GGUF=/path/to/Ternary-Bonsai-27B-gguf/Ternary-Bonsai-27B-Q2_g64.gguf

# e.g. Offload to the 24 GB RTX 3090 only
CUDA_VISIBLE_DEVICES=0
