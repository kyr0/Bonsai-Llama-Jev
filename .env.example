# Copy to .env and adjust. .env is gitignored and loaded by setup.sh,
# scripts/*.sh (via scripts/common.sh) and the Makefile.
# Already-exported shell env vars win over values in .env.

# Server bind address / port (start_llama_server.sh, make start/status/stop)
PORT=8080
BONSAI_HOST=127.0.0.1

# Require this API key on the OpenAI-compatible endpoints (llama-server --api-key).
# Empty = no auth.
#BONSAI_API_KEY=

# Model name reported by /v1/models (llama-server --alias).
# Empty = the GGUF file name.
#BONSAI_ALIAS=bonsai-2-27b

# Model selection (see scripts/common.sh)
#BONSAI_FAMILY=bonsai2
#BONSAI_MODEL=27B
